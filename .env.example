# =====================================================
# Coffee Store · Variables de entorno
# =====================================================
# Copiá este archivo a `.env.local` y completá los valores.

# --- Supabase ---------------------------------------------------------
# Los encontrás en Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor (NUNCA exponer al cliente). Usar en API routes / server actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nombre del schema en Supabase
NEXT_PUBLIC_SUPABASE_SCHEMA=coffeestore

# --- WhatsApp --------------------------------------------------------
# Número que recibe los pedidos (sin espacios ni símbolos, con código de país)
NEXT_PUBLIC_WHATSAPP_NUMBER=595981772872

# --- Admin -----------------------------------------------------------
# Email de la cuenta administradora (creá el usuario en Supabase Auth)
ADMIN_EMAIL=admin@coffeestore.py

# --- App -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=PYG
NEXT_PUBLIC_CURRENCY_LOCALE=es-PY
